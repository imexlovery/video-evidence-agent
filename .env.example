# Copy this file to .env and fill OPENAI_API_KEY once. The project loads the
# gitignored .env automatically; never commit the filled file or paste the key
# into source code, reports, or chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# Existing video-evidence answering model.
VIDEO_EVIDENCE_MODEL=deepseek-v4-flash-vision-exp
VIDEO_EVIDENCE_TIMEOUT_SECONDS=120

# Video Visual Report V1-A Topic Mapper and Report Planner model. Keep this
# explicit so every real planning run records and freezes the exact model.
VISUAL_REPORT_MODEL=deepseek-v4-flash-vision-exp
VISUAL_REPORT_TIMEOUT_SECONDS=120

# The local ASR model is downloaded on the first real ingest.
VIDEO_EVIDENCE_ASR_MODEL=mlx-community/whisper-small-mlx
